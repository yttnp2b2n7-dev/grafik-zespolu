generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Person {
  id          String        @id @default(cuid())
  name        String
  color       String
  email       String?
  phone       String?
  createdAt   DateTime      @default(now())
  skills        PersonSkill[]
  assignments   Assignment[]
  vacations     Vacation[]
  assignedTasks EventTask[]
}

model Vacation {
  id        String   @id @default(cuid())
  personId  String
  startDate DateTime
  endDate   DateTime
  note      String?
  createdAt DateTime @default(now())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model Skill {
  id     String        @id @default(cuid())
  name   String        @unique
  people PersonSkill[]
}

model PersonSkill {
  personId String
  skillId  String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([personId, skillId])
}

enum EventType {
  MONTAZ
  OBSLUGA
  DEMONTAZ
  ZALADUNEK
}

enum WorkType {
  OSWIETLENIE
  MULTIMEDIA
  DZWIEK
  SCENOGRAFIA
}

model Event {
  id                String       @id @default(cuid())
  title             String
  startsAt          DateTime
  endsAt            DateTime
  color             String?
  groupId           String?
  eventTypes        EventType[]  @default([])
  loadingEnabled    Boolean      @default(false)
  loadingTime       String?
  transportEnabled   Boolean      @default(false)
  transportVehicleId String?
  transportVehicle   Vehicle?     @relation("EventTransportVehicle", fields: [transportVehicleId], references: [id], onDelete: SetNull)
  notes              String?
  managerNote        String?
  assignments        Assignment[]
  vehicleAssignments VehicleAssignment[]
  tasks              EventTask[]

  @@index([groupId])
  @@index([startsAt])
  @@index([endsAt])
}

model EventTask {
  id         String    @id @default(cuid())
  eventId    String
  text       String
  done       Boolean   @default(false)
  assigneeId String?
  dueDate    DateTime?
  createdAt  DateTime  @default(now())
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignee   Person?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([eventId])
}

model Assignment {
  id        String      @id @default(cuid())
  eventId   String
  personId  String
  isLead    Boolean     @default(false)
  roles     EventType[] @default([])
  workTypes WorkType[]  @default([])
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person    Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([eventId, personId])
}

model Vehicle {
  id             String              @id @default(cuid())
  name           String
  plateNumber    String?
  type           String?
  capacity       String?
  inspectionDate DateTime?
  insuranceDate  DateTime?
  note           String?
  createdAt      DateTime            @default(now())
  assignments    VehicleAssignment[]
  serviceBlocks  VehicleService[]
  transportEvents Event[] @relation("EventTransportVehicle")
  notes          VehicleNote[]
}

model VehicleNote {
  id         String    @id @default(cuid())
  vehicleId  String
  text       String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model VehicleService {
  id        String   @id @default(cuid())
  vehicleId String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model VehicleAssignment {
  id        String  @id @default(cuid())
  eventId   String
  vehicleId String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([eventId, vehicleId])
}
