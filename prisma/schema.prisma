generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Person {
  id          String        @id @default(cuid())
  name        String
  color       String
  email       String?
  phone       String?
  createdAt   DateTime      @default(now())
  skills      PersonSkill[]
  assignments Assignment[]
  vacations   Vacation[]
}

model Vacation {
  id        String   @id @default(cuid())
  personId  String
  startDate DateTime
  endDate   DateTime
  note      String?
  createdAt DateTime @default(now())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model Skill {
  id     String        @id @default(cuid())
  name   String        @unique
  people PersonSkill[]
}

model PersonSkill {
  personId String
  skillId  String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([personId, skillId])
}

enum EventType {
  MONTAZ
  OBSLUGA
  DEMONTAZ
  ZALADUNEK
}

enum WorkType {
  OSWIETLENIE
  MULTIMEDIA
  DZWIEK
  SCENOGRAFIA
}

model Event {
  id                String       @id @default(cuid())
  title             String
  startsAt          DateTime
  endsAt            DateTime
  color             String?
  groupId           String?
  eventTypes        EventType[]  @default([])
  loadingEnabled    Boolean      @default(false)
  loadingTime       String?
  transportEnabled  Boolean      @default(false)
  transportVehicle  String?
  notes             String?
  assignments       Assignment[]
  vehicleAssignments VehicleAssignment[]

  @@index([groupId])
  @@index([startsAt])
  @@index([endsAt])
}

model Assignment {
  id        String      @id @default(cuid())
  eventId   String
  personId  String
  isLead    Boolean     @default(false)
  roles     EventType[] @default([])
  workTypes WorkType[]  @default([])
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person    Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([eventId, personId])
}

model Vehicle {
  id             String              @id @default(cuid())
  name           String
  plateNumber    String?
  type           String?
  capacity       String?
  inspectionDate DateTime?
  insuranceDate  DateTime?
  note           String?
  createdAt      DateTime            @default(now())
  assignments    VehicleAssignment[]
}

model VehicleAssignment {
  id        String  @id @default(cuid())
  eventId   String
  vehicleId String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([eventId, vehicleId])
}
